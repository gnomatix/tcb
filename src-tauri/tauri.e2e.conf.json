{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TCB, M.D.",
        "width": 1000,
        "height": 720,
        "minWidth": 400,
        "minHeight": 300,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true,
        "zoomHotkeysEnabled": false,
        "url": "index.html",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --remote-debugging-port=9222"
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false
  }
}
